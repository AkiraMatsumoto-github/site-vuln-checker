{
  "manifest_version": 3,
  "name": "サイト脆弱性チェッカー",
  "version": "1.0.0",
  "description": "最新の米国国立脆弱性データベースを用い、Webサイトの脆弱性を簡易的にチェックするプラグインです。",
  "permissions": ["sidePanel", "activeTab", "tabs", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "サイト脆弱性チェッカー — このサイトを調べる",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "minimum_chrome_version": "116"
}
